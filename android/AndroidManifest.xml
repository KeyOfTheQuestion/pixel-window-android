<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="local.pixel.window"
    android:versionCode="12" android:versionName="1.1.6">
    <uses-sdk android:minSdkVersion="30" android:targetSdkVersion="34"/>
    <application android:label="像素窗景" android:icon="@drawable/window_icon"
        android:allowBackup="false" android:theme="@android:style/Theme.Material.NoActionBar">
        <activity android:name=".MainActivity" android:exported="true" android:screenOrientation="reverseLandscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
    </application>
</manifest>
